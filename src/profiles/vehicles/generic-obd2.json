      "request": {
        "type": "obd",
        "pid": "1F"
      },
      "decode": {
        "bytes": 2
      },
      "range": [0, 65535]
    },
    {
      "id": "distanceMil",
      "name": "Distance with check-engine light on",
      "short": "MIL DIST",
      "unit": "km",
      "request": {
        "type": "obd",
        "pid": "21"
      },
      "decode": {
        "bytes": 2
      },
      "range": [0, 65535]
    },
    {
      "id": "fuelRailPressure",
      "name": "Fuel rail gauge pressure",
      "short": "RAIL PRESS",
      "unit": "kPa",
      "request": {
        "type": "obd",
        "pid": "23"
      },
      "decode": {
        "bytes": 2,
        "scale": 10
      },
      "range": [0, 200000]
    },
    {
      "id": "fuelLevel",
      "name": "Fuel level",
      "short": "FUEL",
      "unit": "%",
      "request": {
        "type": "obd",
        "pid": "2F"
      },
      "decode": {
        "scale": 0.392157
      },
      "range": [0, 100],
      "simulate": {
        "idle": 60,
        "load": 60
      }
    },
    {
      "id": "baro",
      "name": "Barometric pressure",
      "short": "BARO",
      "unit": "kPa",
      "request": {
        "type": "obd",
        "pid": "33"
      },
      "range": [80, 105],
      "simulate": {
        "idle": 95,
        "load": 95
      }
    },
