    },
    {
      "id": "pedal",
      "name": "Accelerator pedal position D",
      "short": "PEDAL",
      "unit": "%",
      "request": {
        "type": "obd",
        "pid": "49"
      },
      "decode": {
        "scale": 0.392157
      },
      "range": [0, 100],
      "simulate": {
        "idle": 0,
        "load": 45
      }
    },
    {
      "id": "oilTemp",
      "name": "Engine oil temperature",
      "short": "OIL TEMP",
      "unit": "°C",
      "request": {
        "type": "obd",
        "pid": "5C"
