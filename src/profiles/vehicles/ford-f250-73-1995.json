{
  "id": "ford-f250-73-1995",
  "name": "1995 F-250 7.3 Powerstroke",
  "styles": ["ford95", "performance"],
  "connection": {
    "protocol": "j1850pwm",
    "headers": ["C410F1", "616AF1"],
    "manufacturerHeader": "C410F1",
    "standardHeader": "616AF1"
  },
  "fuel": "diesel",
  "parameters": [
    {
      "id": "rpm",
      "name": "Engine speed",
      "short": "RPM",
      "unit": "rpm",
      "request": {
        "type": "obd",
        "pid": "0C"
      },
      "decode": {
        "bytes": 2,
        "scale": 0.25
      },
      "range": [0, 4000],
      "redline": 3300,
      "verified": true,
      "note": "Answered on this truck (Nov 2026) with sensible idle values.",
      "simulate": {
        "idle": 680,
        "load": 2400
      }
    },
    {
      "id": "speed",
      "name": "Vehicle speed",
      "short": "SPEED",
