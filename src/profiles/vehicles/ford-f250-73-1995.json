      "pollMs": 2000
    },
    {
      "id": "mapAbs",
      "name": "Manifold absolute pressure",
      "short": "MAP",
      "unit": "psi",
      "request": {
        "type": "manufacturer",
        "did": "1440"
      },
      "decode": {
        "bytes": 2,
        "scale": 0.03625
      },
      "range": [0, 45],
      "verified": true,
      "note": "Answered on this truck (Nov 2026) with sensible idle values.",
      "simulate": {
        "idle": 14.4,
        "load": 32
      }
    },
    {
      "id": "baro",
      "name": "Barometric pressure",
      "short": "BARO",
      "unit": "psi",
      "request": {
        "type": "manufacturer",
        "did": "1442"
      },
      "decode": {
        "bytes": 2,
        "scale": 0.03625
      },
      "range": [10, 15],
      "verified": false,
      "note": "Answers, but reads a fixed 14.5 psi on this truck in every session (raw 0x190), even when MAP and EBP read 14.0 and 14.4 with the engine off. Not a live sensor reading.",
      "simulate": {
        "idle": 13.6,
        "load": 13.6
      },
      "pollMs": 10000
    },
    {
      "id": "boost",
      "name": "Boost (MAP − BARO)",
      "short": "BOOST",
      "unit": "psi",
      "request": {
        "type": "zeroed",
        "of": "mapAbs",
        "idle": "rpm",
        "fallback": "baro"
      },
      "range": [0, 15],
      "normal": [0, 15],
      "note": "MAP now minus MAP with the engine stopped (taken at key-on, remembered between sessions). This truck's BARO reads a fixed 14.5 psi, so it's only used until the first key-on."
    },
    {
      "id": "ebpAbs",
      "name": "Exhaust back pressure (absolute)",
      "short": "EBP ABS",
      "unit": "psi",
      "request": {
        "type": "manufacturer",
        "did": "1445"
      },
      "decode": {
        "bytes": 2,
        "scale": 0.03625
      },
      "range": [0, 60],
      "verified": true,
      "note": "Answered on this truck (Nov 2026) with sensible idle values.",
      "simulate": {
        "idle": 15,
        "load": 40
      }
    },
    {
      "id": "ebp",
      "name": "Exhaust back pressure (gauge)",
      "short": "EXH BACK",
      "unit": "psi",
      "request": {
        "type": "zeroed",
        "of": "ebpAbs",
        "idle": "rpm",
        "fallback": "baro"
      },
      "range": [0, 30],
      "redline": 10,
      "normal": [0, 10],
      "note": "EBP now minus EBP with the engine stopped, the same way as boost."
    },
    {
      "id": "mat",
      "name": "Manifold air temperature",
      "short": "INTAKE AIR",
      "unit": "°F",
      "request": {
        "type": "obd",
        "pid": "0F"
      },
      "decode": {
        "bytes": 1,
        "scale": 1.8,
        "offset": -40
      },
      "range": [0, 200],
      "redline": 180,
      "verified": false,
      "note": "Neither Ford ID 16E0 (refused) nor standard PID 0F (always 0, i.e. -40°F) gives intake air temperature on this truck.",
      "simulate": {
        "idle": 70,
        "load": 115
      },
      "pollMs": 2000
    },
    {
      "id": "battery",
      "name": "Battery voltage at the OBD port",
      "short": "BATTERY",
      "unit": "V",
      "request": {
        "type": "adapterVoltage"
      },
      "range": [10, 16],
      "redline": 15.2,
      "simulate": {
        "idle": 14.1,
        "load": 14.2
      },
      "note": "Measured by the adapter at the OBD port; shows the dip while cranking."
    }
  ],
  "gaugeLayout": ["boost", "icp", "ebp", "fipw", "eot", "battery", "ipr", "rpm"]
}
