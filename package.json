{
  "name": "obd-gauges",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only OBD2 gauge display PWA for the 1995 F-250 7.3 Powerstroke and standard OBD2 vehicles.",
  "scripts": {
    "dev": "vite --host --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.0"
    }
  }
}
